# Required for real hosted AI. App 2 uses this key to call hosted Gemini models.
GEMINI_API_KEY=""

# Optional. App 2 defaults to Gemini 2.5 Flash for both vision and text.
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_VISION_MODEL="gemini-2.5-flash"
GEMINI_TEXT_MODEL="gemini-2.5-flash"

# Optional Gemma 4 path: set the GEMINI_* model variables above to gemma-4-26b-a4b-it
# only if this key/project has explicit model access.

# Optional. Points to App 2's standalone local bridge (npm run dev:bridge).
# Leave empty to use the default http://localhost:3202.
VITE_ARDUINO_BRIDGE_URL="http://localhost:3202"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""
