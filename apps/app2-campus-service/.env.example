# Required for real hosted AI. App 2 uses this key to call Gemma through the Gemini API.
GEMINI_API_KEY=""

# Optional. Hosted Gemma model IDs used by the bridge AI routes.
GEMMA_VISION_MODEL="gemma-4-26b-a4b-it"
GEMMA_TEXT_MODEL="gemma-4-26b-a4b-it"

# Optional. Points to App 2's standalone local bridge (npm run dev:bridge).
# Leave empty to use the default http://localhost:3202.
VITE_ARDUINO_BRIDGE_URL="http://localhost:3202"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""
