# Optional. Without a key, AI routes use the local fallback engine and the UI labels it clearly.
GEMINI_API_KEY=""

# Default hosted model. Use Gemini 2.5 Flash for the App 1 closed loop.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# Optional hosted Gemma 4 override when enabled for your key/account:
# GEMINI_MODEL=gemma-4-26b-a4b-it
# GEMINI_VISION_MODEL=gemma-4-26b-a4b-it

# Local bridge and production single-server port.
BRIDGE_PORT=3201

# Optional Arduino Serial settings. Without ARDUINO_PORT, the bridge stays in demo/fallback mode.
# App 1 owns this bridge. App 2/App 3 use their own app-local bridge settings.
ARDUINO_BAUD=115200
# ARDUINO_PORT=/dev/cu.usbmodemXXXX
