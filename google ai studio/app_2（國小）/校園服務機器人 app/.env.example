# Optional. Current demo uses local AI helpers and does not require Gemini.
GEMINI_API_KEY=""

# Optional. Points to App 2's standalone local bridge (npm run dev:bridge).
# Leave empty to use the default http://localhost:3202.
VITE_ARDUINO_BRIDGE_URL="http://localhost:3202"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""
